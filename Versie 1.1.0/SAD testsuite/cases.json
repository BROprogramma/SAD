{
  "_uitleg": "Gedeelde handgeschreven testcases voor alle versies. Elke case neemt een goed bericht (source of sources), past het in het geheugen aan (mutations) en controleert dat de XSLT van het regime van dat bericht de verwachte NIEUWE melding geeft. Versie-afhankelijke waarden staan als ${NAAM} in de case en worden ingevuld uit <versie>/Tests/versie.json. Met \"versies\": [\"mapnaam\"] geldt een case alleen voor die versie(s). Zie README.md voor alle acties.",
  "cases": [
    {
      "name": "Metadata - dataflow ontbreekt",
      "sources": [
        "3. SAD_registrationRequest IMBRO.xml",
        "1. SAD_registrationRequest IMBROA.xml"
      ],
      "mutations": [
        {
          "xpath": "//imsikb0101:metaData/imsikb0101:dataflow",
          "action": "remove"
        }
      ],
      "expect": [
        {
          "type": "WARNING",
          "title_contains": "dataflow",
          "message_contains": "Er zou een metadata/dataflow ingevuld moeten zijn"
        },
        {
          "type": "WARNING",
          "title_contains": "dataflow",
          "message_contains": "zou ingevuld moeten zijn met"
        }
      ]
    },
    {
